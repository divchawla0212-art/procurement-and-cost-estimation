# Procurement Comparison — environment template
# Copy this file to `.env` and fill in your values, then run:
#   uvicorn api.main:app --reload --port 8000
# `.env` is git-ignored — NEVER commit real API keys.

# ── LLM provider ─────────────────────────────────────────────────────────────
# Which provider runs the bid extraction: anthropic | openai | bedrock | gemini | mock
# (You can also pick a provider per ingestion run from the web app.)
LLM_PROVIDER=anthropic

# ── Anthropic ────────────────────────────────────────────────────────────────
# Required when LLM_PROVIDER=anthropic. Also powers the scanned-PDF transcription
# fallback (used for image-only PDFs) regardless of the selected provider.
ANTHROPIC_API_KEY=

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Required when LLM_PROVIDER=openai.
OPENAI_API_KEY=

# ── Optional model overrides ─────────────────────────────────────────────────
# Override the extraction model for the selected provider:
# LLM_MODEL=
# Model for the Anthropic PDF-transcription fallback (scanned/image PDFs):
# PDF_LLM_MODEL=claude-sonnet-4-5
# Sampling temperature. Unset means "send none", which is the default and what
# production has always done. The parser A/B pins it to 0 so a difference
# between arms is attributable to the PDF reader rather than to sampling.
# LLM_TEMPERATURE=0

# ── LlamaParse (optional, for tools/parser_ab.py only) ───────────────────────
# Only the PDF-parser comparison uses this; the pipeline never calls LlamaParse.
# Needs the optional extra:  pip install -e '.[llamaparse]'
# Note `llama-parse` and `llama-cloud-services` are both deprecated packages —
# the maintained one is `llama-cloud>=1.0`, which is what the extra installs.
# LLAMA_CLOUD_API_KEY=
# Which tier to parse with: fast | cost_effective | agentic | agentic_plus
# LLAMAPARSE_TIER=agentic
# Where parsed markdown is cached, keyed by file hash, so a re-run is free:
# LLAMAPARSE_CACHE_DIR=.llamaparse-cache

# ── Amazon Bedrock (optional) ────────────────────────────────────────────────
# Set LLM_PROVIDER=bedrock. Auth is AWS IAM — no key here, just the region.
# AWS_REGION=us-east-1

# ── Google Gemini (optional) ─────────────────────────────────────────────────
# Set LLM_PROVIDER=gemini.
# GEMINI_API_KEY=

# ── Storage ──────────────────────────────────────────────────────────────────
# Where projects are stored on disk (default: projects/)
# PROCUREMENT_PROJECTS_ROOT=projects

# ── Accounts ─────────────────────────────────────────────────────────────────
# The first administrator, created on startup **only while no user exists**.
# Set both, or the deployment comes up with nobody who can reach anything:
# every /api/ path needs a session, a self-registered account is a reviewer
# with no project access, and only an admin can grant access. The app logs a
# warning and still starts, so this failure is quiet — check the logs, or just
# set these before the first run. Changing them later does nothing; once one
# user exists the seeding is skipped. Manage people from the Users and access
# screen after signing in.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Set to 0 to close public self-registration. An admin can still add people
# from the Users and access screen. Default 1.
# ALLOW_SIGNUP=1

# ── Mail ─────────────────────────────────────────────────────────────────────
# Unset (or empty/0/false) keeps every send in <ROOT>/outbox/ as a .eml and
# reaches nobody. MAIL_TRANSPORT=smtp is the deliberate opt-in to real mail.
MAIL_TRANSPORT=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
