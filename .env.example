# Procurement Comparison Portal — environment template
# Copy this file to `.env` and fill in your values, then run:  streamlit run portal/app.py
# `.env` is git-ignored — NEVER commit real API keys.

# ── LLM provider ─────────────────────────────────────────────────────────────
# Which provider runs the bid extraction: anthropic | openai | bedrock | gemini | mock
# (You can also switch this from the portal's sidebar at runtime.)
LLM_PROVIDER=anthropic

# ── Anthropic ────────────────────────────────────────────────────────────────
# Required when LLM_PROVIDER=anthropic. Also powers the scanned-PDF transcription
# fallback (used for image-only PDFs) regardless of the selected provider.
ANTHROPIC_API_KEY=

# ── OpenAI ───────────────────────────────────────────────────────────────────
# Required when LLM_PROVIDER=openai.
OPENAI_API_KEY=

# ── Optional model overrides ─────────────────────────────────────────────────
# Override the extraction model for the selected provider:
# LLM_MODEL=
# Model for the Anthropic PDF-transcription fallback (scanned/image PDFs):
# PDF_LLM_MODEL=claude-sonnet-4-5

# ── Amazon Bedrock (optional) ────────────────────────────────────────────────
# Set LLM_PROVIDER=bedrock. Auth is AWS IAM — no key here, just the region.
# AWS_REGION=us-east-1

# ── Google Gemini (optional) ─────────────────────────────────────────────────
# Set LLM_PROVIDER=gemini.
# GEMINI_API_KEY=

# ── Storage ──────────────────────────────────────────────────────────────────
# Where projects are stored on disk (default: projects/)
# PROCUREMENT_PROJECTS_ROOT=projects
