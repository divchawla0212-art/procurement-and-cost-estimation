# `.env` is re-included in the build context on purpose, so the `env-true` stage
# can bake it when INCLUDE_ENV=true. It is NOT copied by the application COPY —
# the `source` stage deletes it — so INCLUDE_ENV=false still yields an image with
# no key in any layer. Every other env file stays excluded unconditionally.
.env.*
!.env.example

# Version control / tooling
.git
.github
.gitignore
.claude
.superpowers
.pytest_cache
.worktrees

# Local Python environments and build residue
.venv
venv
*.egg-info
__pycache__
**/__pycache__
*.py[cod]

# Node: reinstalled from the lockfile inside the build stage
web/node_modules
web/dist

# Runtime data — lives in a volume, not in the image
projects/
data/
processed-data/

# ...except the bundled sample project, which ships as a read-only seed under
# /app/samples and is copied into the volume on first start. Only this one slug
# is re-included, so the build context stays small.
!projects/gas-14

# Docs and notebooks add nothing to the runtime
docs
*.ipynb
Dockerfile
docker-compose.yml
.dockerignore
