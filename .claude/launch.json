{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "procurement-api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "api.main:app", "--reload", "--port", "8000", "--env-file", ".env"],
